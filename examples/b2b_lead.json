{"summary":{"one_sentence":"为虚构企业软件公司设计从线索接入到 CRM 分配、再到评分复盘的受控方案。","business_goal":"减少销售整理线索的重复劳动，同时让分级和外发承诺保留人工责任。","business_background":["示例公司的表单和聊天记录来自多个入口。","销售需要在 CRM 中完成分配和跟进。","本方案只生成建议，销售确认后才写入 CRM。"],"pain_points":["字段缺失和授权状态不清。","不同销售对高价值线索判断不一致。","转化结果没有稳定回流评分规则。"],"key_metrics":[{"metric":"字段完整率","current_value":"待确认","example_target":"示例目标值：≥95%，需与客户确认"},{"metric":"分级建议接受率","current_value":"待确认","example_target":"示例目标值：≥80%，需与客户确认"},{"metric":"应升级漏转率","current_value":"待确认","example_target":"示例目标值：0，需与客户确认"},{"metric":"首次响应时长","current_value":"待确认","example_target":"示例目标值：较基线下降20%，需与客户确认"}]},"scenarios":[{"name":"表单与聊天接入","trigger":"新表单或聊天记录进入队列","inputs":["表单","聊天记录"],"expected_output":"标准化线索记录","frequency_scale":"高频","involved_systems":["官网","会话系统"]},{"name":"字段完整性与授权校验","trigger":"线索记录创建","inputs":["联系人","授权状态"],"expected_output":"可处理记录或补充清单","frequency_scale":"高频","involved_systems":["线索池","授权系统"]},{"name":"线索信息提取与打分","trigger":"字段完整","inputs":["原文","评分规则"],"expected_output":"字段、分级建议和依据","frequency_scale":"高频","involved_systems":["Agent 服务","规则库"]},{"name":"分级确认与话术审核","trigger":"建议生成","inputs":["分级建议","话术草稿"],"expected_output":"销售确认结果","frequency_scale":"中频","involved_systems":["销售工作台"]},{"name":"写入 CRM 并分配销售","trigger":"销售确认","inputs":["确认线索","分配规则"],"expected_output":"CRM 记录和负责人","frequency_scale":"高频","involved_systems":["CRM","任务系统"]},{"name":"转化结果回流调分","trigger":"每周复盘","inputs":["跟进结果","转化状态"],"expected_output":"规则调整建议","frequency_scale":"每周","involved_systems":["CRM","数据看板"]}],"boundary":[{"scenario":"表单与聊天接入","owner":"Workflow","reason":"入口归档和字段映射规则固定。","failed_handoff_to":"销售运营","handoff_condition":"来源无法识别或重复记录。"},{"scenario":"字段完整性与授权校验","owner":"Workflow","reason":"必填和授权可按规则验证。","failed_handoff_to":"销售运营","handoff_condition":"授权不明或字段缺失。"},{"scenario":"线索信息提取与打分","owner":"Agent","reason":"需理解非结构化表达并组合规则。","failed_handoff_to":"销售负责人","handoff_condition":"信息冲突、低置信度或高价值线索。"},{"scenario":"分级确认与话术审核","owner":"Human","reason":"影响销售资源投入和对外沟通。","fa